# Python virtual environment (large, machine-specific -- reinstall from
# requirements instead of tracking)
opensimPy/
.venv/
venv/

# Environment / secrets
.env
*.env

# Raw + processed subject data (large, not source-controlled)
data/

# Validation scratch outputs (regenerated on demand from results/)
validation/

# Old/backup data snapshots
dump/

# resources/ -- keep only .md files (literature_notes.md etc.); exclude the
# reference pipeline code/data and generic OpenSim tutorial assets (not
# project-specific, large binary meshes)
resources/_old_reference_code/
resources/_opensim_reference/
resources/_python_coding_reference/

# OpenSim model files -- wherever they occur (per-subject scaled models in
# results/, experimental models in code/expt_temp/), EXCEPT the source
# unscaled model templates in code/assets/models/unscaled/ (~3.6MB) -- those
# are code, needed to actually run the pipeline, not generated data.
*.osim
!code/assets/models/unscaled/*.osim

# Logs
*.log

# Claude Code session/local project settings
.claude/

# Python
__pycache__/
*.pyc
*.pyo

# OS / editor cruft
.DS_Store
Thumbs.db

# Pre-change backups written by promotion scripts (promote_sync.py,
# apply_ideal_gains.py) -- local safety copies, not source.
*.presync.json
*.prebenchmark.json

# Experimental scratch area -- sanctioned per CLAUDE.md, never imported by
# production code. Untracked deliberately: one-off investigations, not source.
# Their conclusions live in resources/*.md and any load-bearing output is
# promoted into code/subject_rules/ before it matters.
# Experimental scratch area. Its SOURCE and FINDINGS are tracked (scripts and
# READMEs are the record of how each investigation was done and what it
# concluded); its rendered plots and binary outputs are not, since they are
# regenerable by rerunning those scripts and run to ~130 MB.
#
# Note the directory itself is NOT excluded -- git will not descend into an
# excluded directory, so a negation inside one never matches. The files are
# excluded instead, then selectively re-included.
code/expt_temp/**
!code/expt_temp/**/
!code/expt_temp/**/*.py
!code/expt_temp/**/*.md
!code/expt_temp/**/*.sh
!code/expt_temp/**/*.json
!code/expt_temp/**/*.csv
code/expt_temp/**/__pycache__/**
